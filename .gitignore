node_modules/
.node/

# Local working drafts of planning documents. The docs/plans/ specs
# (MULTIUSER_PLAN.md, BENCHMARKING_PLAN_V8.md) are local-only now --
# see the docs/* block below.
/plans/
*PLAN*.md

# docs/: only the public documentation is tracked (API.md, ARCHITECTURE.md,
# DEPLOYMENT.md). Plans, research and internal notes stay local. We ignore
# docs/* (not docs/ itself) so the re-include exceptions below work.
docs/*
!docs/API.md
!docs/ARCHITECTURE.md
!docs/DEPLOYMENT.md

# Claude Code session runtime state (e.g. launch.json, scheduled_tasks.lock)
# -- created by the Claude Code app itself when used against this folder,
# not project source.
.claude/
*.db
*.db-journal
*.db-wal
*.db-shm
raw/*.json

# Client/admin build output -- generated by `npm run build`/`npm run build:admin`, not source.
client/dist/
admin/dist/

# Builds installed via the Workers page, using the default
# llama_cpp_builds_dir (worker/llama-builds/ next to worker/).
worker/llama-builds/

# Daily worker log files, using the default log_dir (worker/logs/ next to
# worker/) -- runtime output, not source.
worker/logs/
# Header placeholders for sizing models not on the machine (worker/src/headerFit.ts).
worker/header-cache/

# Per-run structured log files, using the default LOG_DIR (data/run-logs/
# next to the server's cwd, see server/src/routes/runs.ts) -- runtime
# output, not source. Also covers the local dev-verify.db* sidecars that
# land alongside it (already excluded by the *.db* patterns above).
data/

# Real deploy env files (created from deploy/orchestrator.env.example) --
# environment-specific Tailscale IPs, not meant to be committed.
*.env
!*.env.example

# Real worker configs (created from worker/config*.json.example) -- same
# reason: real Tailscale IPs and local filesystem paths, not meant to be committed.
worker/config.json
worker/config.vps.json

# Per-model "working" MTP prompt offset, learned live by worker/src/serverBench.ts
# (see its DEFAULT_OFFSET_STORE_PATH) -- runtime state, not source.
worker/mtp-offsets.json

# The Serve page's state on a worker (worker/src/daemon/store.ts): API key hashes,
# usage counts and the owner's own system prompt.
worker/daemon-state.json*

# Throwaway verification scripts and screenshot dumps from local debugging
# sessions -- never project source.
scripts/_*

# Chrome extension build output -- generated by `npm run build` in extension/.
extension/dist/
worker/chrome-host/com.llamatoaster.vram.json
worker/chrome-host/vram-host.sh

# Chrome extension signing key and the package signed with it -- never commit
extension/dist.pem
extension/dist.crx
