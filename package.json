{
  "name": "llamatoaster",
  "version": "2.0.0",
  "private": true,
  "description": "LLM Benchmark Web App (Lean MVP) — VPS orchestrator + worker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noname9006/LlamaToaster.git"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "llamatoaster": "bin/llamatoaster.cjs"
  },
  "scripts": {
    "server": "tsx server/src/index.ts",
    "worker": "tsx worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --prefix client",
    "build:admin": "npm run build --prefix admin",
    "dev:client": "npm run dev --prefix client",
    "dev:admin": "npm run dev --prefix admin",
    "install:client": "npm install --prefix client",
    "install:admin": "npm install --prefix admin",
    "postinstall": "npm install --prefix client && npm install --prefix admin"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.2",
    "systeminformation": "^5.22.10",
    "tsx": "4.19.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
