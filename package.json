{
  "name": "llamatoaster",
  "version": "2.0.0",
  "private": true,
  "description": "LLM Benchmark Web App (Lean MVP) — VPS orchestrator + worker",
  "type": "module",
  "scripts": {
    "server": "tsx server/src/index.ts",
    "worker": "tsx worker/src/index.ts",
    "build": "npm run build --prefix client",
    "dev:client": "npm run dev --prefix client",
    "install:client": "npm install --prefix client",
    "postinstall": "npm install --prefix client"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^13.0.2",
    "fastify": "^5.11.2",
    "systeminformation": "^5.22.10",
    "tsx": "4.19.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/uuid": "^9.0.8",
    "typescript": "^5.5.4"
  }
}
