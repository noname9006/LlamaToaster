{
  "name": "llamatoaster",
  "version": "2.0.0",
  "private": true,
  "description": "LLM Benchmark Web App (Lean MVP) — VPS orchestrator + worker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noname9006/LlamaToaster.git"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "type": "module",
  "bin": {
    "llamatoaster": "bin/llamatoaster.cjs"
  },
  "scripts": {
    "server": "tsx server/src/index.ts",
    "worker": "tsx worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:node": "vitest run --project node",
    "test:client": "vitest run --project client",
    "typecheck": "tsc --noEmit",
    "build": "npm run build --prefix client",
    "build:admin": "npm run build --prefix admin",
    "dev:client": "npm run dev --prefix client",
    "dev:admin": "npm run dev --prefix admin",
    "install:client": "npm install --prefix client",
    "install:admin": "npm install --prefix admin",
    "postinstall": "npm install --prefix client && npm install --prefix admin"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.4",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "systeminformation": "^5.33.13",
    "tsx": "4.23.15",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
