# npm's automatic vulnerability audit (POST /-/npm/v1/security/advisories/bulk)
# on every `npm install` hits a slow registry.npmjs.org endpoint that can take
# minutes -- or hang indefinitely -- with zero console output while it waits,
# even when every package itself resolves from cache instantly. Confirmed via
# a real install: 131 packages resolved in 0ms each, then one audit POST took
# 226897ms. Disable it; run `npm audit` manually when you actually want it.
audit=false
