# Copy to orchestrator.env (not committed) and fill in the real Tailscale IPs.
PORT=3000
BIND_HOST=<vps-tailscale-ip>
DB_PATH=/home/ubuntu/LlamaToaster/data/llamatoaster.db

# The VPS CPU worker started by llamatoaster-worker.service, reachable only
# from this same box (see worker/config.vps.json.example's bind_host). Only
# each worker's URL goes here -- its name/backend/active build are
# discovered live from its own /health, not declared. Add your existing GPU
# worker(s) as more entries in the same array once this one is confirmed
# working -- don't switch DEFAULT_WORKER_URL/WORKERS over in one step.
WORKERS=["http://127.0.0.1:8080"]
