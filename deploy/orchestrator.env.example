# Copy to orchestrator.env (not committed) and fill in the real Tailscale IPs.
PORT=3000
BIND_HOST=<vps-tailscale-ip>
DB_PATH=/home/ubuntu/LlamaToaster/data/llamatoaster.db

# Workers are discovered automatically, not declared here: the orchestrator
# runs `tailscale status --json` (needs the `tailscale` CLI on PATH for
# whatever OS user runs this process) and treats every machine on the
# tailnet as a worker candidate, probing each one's own /health on
# WORKER_PORT. A peer with nothing listening still shows up on the Workers
# page -- as "can't be reached", with setup instructions -- rather than
# being omitted.
#
# WORKER_PORT — optional, the port every worker listens on (default 8080).
# All workers must share this one port; per-worker ports are no longer
# supported since there's no way to ask a peer what port it's using before
# you've already had to guess one to ask on.
WORKER_PORT=8080
