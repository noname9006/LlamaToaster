# Copy to orchestrator.env (not committed) and fill in the real Tailscale IPs.
PORT=3000
BIND_HOST=<vps-tailscale-ip>
DB_PATH=/home/ubuntu/LlamaToaster/data/llamatoaster.db

# The VPS CPU worker started by llamatoaster-worker.service, reachable only
# from this same box (see worker/config.vps.json.example's bind_host).
# Add your existing GPU worker(s) as more entries in the same array once
# this one is confirmed working -- don't switch DEFAULT_WORKER_URL/WORKERS
# over in one step.
WORKERS=[{"name":"Remote","backend":"cpu","llama_cpp_build":"none","url":"http://127.0.0.1:8080"}]
