# Copy to orchestrator.env (not committed -- gitignored) and fill in real
# values. Loaded by both deploy paths the same way: systemd's
# EnvironmentFile= (llamatoaster-server.service) and PM2's own
# loadEnvFile helper (deploy/ecosystem.server.config.cjs) both read this file
# verbatim -- edit it once, either deploy path picks it up.
#
# No SESSION_SECRET -- sessions are looked up by sha256(token), there's no
# server-side secret to sign or verify anything with. Do not add one.

# --- Core server ---
PORT=3000
# Once nginx is in front of this process (MULTIUSER_PLAN.md §6.1), this MUST
# be 127.0.0.1 -- the app should not be reachable on any public interface
# directly, only nginx on 80/443 (confirm with the VPS firewall too, not
# just this value). Still-supported alternative: bind directly to this VPS's
# own Tailscale IP instead, with no reverse proxy in front at all, for a
# tailnet-only deployment that never goes public.
BIND_HOST=127.0.0.1
DB_PATH=/home/ubuntu/LlamaToaster/data/llamatoaster.db
# debug | info (default) | warn | error -- debug adds full sweep/trigger/
# tool-call detail to the timestamped request log.
LOG_LEVEL=info
# Where per-run structured worker-activity logs live (see GET /api/runs/:id/log)
# -- optional, defaults to <cwd>/data/run-logs.
LOG_DIR=/home/ubuntu/LlamaToaster/data/run-logs

# --- Multi-user auth (MULTIUSER_PLAN.md §2) ---
# Unset/false: Stage-1-only behavior, no login, everything single-tenant --
# every route below is simply irrelevant until this is true. Flipping it on
# for the first time requires GITHUB_CLIENT_ID/SECRET and PUBLIC_URL to
# already be set correctly, or every login attempt will fail.
AUTH_ENABLED=true

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps on GitHub).
# Callback URL registered with GitHub must be exactly <PUBLIC_URL>/auth/github/callback.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Comma-separated provider:provider_user_id pairs, e.g.
# SUPERADMIN_IDENTITIES=github:123456,google:104852001937446291234 -- NOT
# logins/usernames (those are mutable and get reused), the provider's own
# stable numeric id. Evaluated per-request from this env var, never a stored
# DB column (MULTIUSER_PLAN.md §5.1) -- removing an entry here and
# restarting the process is instant, complete revocation of admin access,
# including every live session.
SUPERADMIN_IDENTITIES=

# The main site's own public origin -- also used to build the OAuth
# redirect_uri and to construct absolute URLs the assistant/emails might
# reference. https:// once nginx/certbot are in front of this (§6.1).
PUBLIC_URL=https://llamatoaster.com
# The admin-only origin (MULTIUSER_PLAN.md §5.1) -- ONE Fastify process
# serves both PUBLIC_URL and this hostname; nginx/DNS just need both to
# resolve here. Leave unset to disable the admin surface entirely (every
# /api/admin/* route 404s with no ADMIN_PUBLIC_URL configured).
ADMIN_PUBLIC_URL=https://supervise.llamatoaster.com

# --- AI assistant (optional -- unset means the panel reports "not configured") ---
# These can also live in a repo-root .env instead (see .env.example) -- both
# are loaded into the same process.env, so either location works identically.
# Kept here too since they're just as much a deployment-time decision as
# everything else in this file.
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# Global circuit breaker (MULTIUSER_PLAN.md §2.6) -- total /api/ai/chat calls
# that reach the provider, across every user, per UTC day. Protects the
# operator's own provider budget regardless of per-user caps. Default 2000
# if unset.
AI_GLOBAL_DAILY_CAP=2000

# --- Legacy Stage 1 worker auth (optional) ---
# A single shared secret every worker presents as a Bearer token -- kept
# working for an already-deployed worker whose config.json was never
# migrated to per-worker device-flow enrolment (MULTIUSER_PLAN.md §3).
# Leave unset once every worker has been re-enrolled via worker/bootstrap.sh;
# new workers never need this at all.
WORKER_SHARED_TOKEN=

# --- Hugging Face Hub GGUF index (optional, but strongly recommended) ---
# The HF index (server/src/hf-index.ts) crawls https://huggingface.co/api/models
# for GGUF repos. Without a token it runs as anonymous (API 500 req /5min,
# Resolvers 3000 /5min). With HF_TOKEN it uses the higher authenticated
# quotas and the server's 5-minute sliding-window limiter (RateLimit /
# RateLimit-Policy headers with r=remaining, t=secondsUntilReset, q=quota;
# mirrors huggingface_hub 1.2.0+ smart 429 retry). Quotas per
# https://huggingface.co/docs/hub/rate-limits:
#   Free: 1000 API / 5000 resolvers /5min, PRO 2500/12000, Team 3000/20000 etc.
# HF_TOKEN takes priority; also accepted: HF_API_KEY, HUGGING_FACE_HUB_TOKEN.
# Create at https://huggingface.co/settings/tokens (read-only is enough -- no scopes).
# When set, per-tick batches auto-scale (100->200 discovery, 50->100 refresh)
# and the limiter spreads requests across the 5-minute fixed windows to avoid
# burst 429s. For workers, set the same var in their env before starting.
HF_TOKEN=
# Optional tuning for the 5-min windows (advanced, rarely needed):
# HF_INDEX_BACKLOG_BATCH_SIZE=500    # one-time newest->oldest catalog walk; token → 500, anon 250
# HF_INDEX_RECENT_BATCH_SIZE=50      # perpetual "what's new" top-up -- small, real upload volume/5min is tiny
# HF_INDEX_MAX_REPOS_PER_TICK=250    # staleness refresh cap (background mode only)
# HF_API_RATE_LIMIT=1000
# HF_RESOLVERS_RATE_LIMIT=5000
# HF_INDEX_TICK_INTERVAL_MS=300000  # 5 min default (HF window)
# HF_INDEX_STALENESS_REFRESH_MODE=on-demand  # or "background"
#   on-demand (default): disables the blind 24h sweep; a repo is only
#     re-checked when a worker reports one of its files' hashes again
#     (hash-lookup already re-verifies a stale match then). Trades
#     background deletion-detection for far less steady-state HF traffic.
#   background: re-checks up to HF_INDEX_MAX_REPOS_PER_TICK stale repos
#     every tick -- one HF API call each, the priciest sweep and the usual
#     driver of "api window full"/"429 backoff" during steady state.

# --- Misc (optional) ---
# Raises GitHub's unauthenticated API rate limit (60/hr) when checking for
# new llama.cpp releases (server/src/github-releases.ts) -- a plain
# "public repo, read-only" personal access token is enough, no scopes needed.
GITHUB_TOKEN=
