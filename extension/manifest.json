{
  "manifest_version": 3,
  "name": "LlamaToaster",
  "short_name": "LlamaToaster",
  "version": "0.1.0",
  "description": "Will this GGUF fit your machine? Reads your RAM/VRAM, measures memory speed, and marks every quant on Hugging Face model pages.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "LlamaToaster",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "system.memory",
    "system.cpu",
    "nativeMessaging",
    "sidePanel"
  ],
  "host_permissions": [
    "https://huggingface.co/*",
    "https://*.huggingface.co/*",
    "https://*.hf.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://huggingface.co/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*",
        "icons/*"
      ],
      "matches": [
        "https://huggingface.co/*"
      ]
    }
  ],
  "key": ""
}
