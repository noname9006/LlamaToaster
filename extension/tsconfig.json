{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["chrome", "@webgpu/types"],
    "typeRoots": ["./node_modules/@types", "./node_modules"]
  },
  "include": ["src"]
}
