# Copy to .env at the repo root (gitignored) to enable the AI Assistant
# panel. Optional -- without this file the panel just shows "not configured"
# and the rest of the app works exactly the same. Loaded automatically on
# server startup via process.loadEnvFile() (see server/src/index.ts); no
# restart-free reload -- edit this file, then restart `npm run server`.
#
# All three are required together. AI_BASE_URL must be an OpenAI-compatible
# `/chat/completions` base (no trailing /chat/completions) -- pick one:
#   OpenRouter:        https://openrouter.ai/api/v1
#   Google AI Studio:  https://generativelanguage.googleapis.com/v1beta/openai
#   anything else that speaks the same wire format (a local Ollama, another
#   gateway) works too.
AI_API_KEY=
AI_BASE_URL=
# AI_MODEL is a comma-separated priority list -- the first model is tried
# first; if every attempt at a model fails (timeout, 4xx/5xx, network error)
# it's put on a 15-minute cooldown and the next model in the list is tried.
# Once a model's cooldown expires, later requests try it again from the top.
# A single model (no comma) works exactly as before.
#   AI_MODEL=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,openrouter/free
AI_MODEL=

# --- Hugging Face Hub (optional, for the GGUF index & model picker) ---
# Without HF_TOKEN the server and worker use anonymous quotas:
#   API 500 /5min, Resolvers 3000 /5min.
# With HF_TOKEN set, they use authenticated quotas and the server's
# 5-minute sliding-window limiter auto-learns the true tier from the
# RateLimit / RateLimit-Policy headers (mirrors huggingface_hub's smart
# retry: on 429 waits exactly t= seconds from the header, wraps search-
# pagination and file downloads). Quotas:
#   Free user: 1000 API / 5000 resolvers /5min; PRO 2500/12000; Team 3000/20000 etc.
#   See https://huggingface.co/docs/hub/rate-limits
# HF_TOKEN takes priority; fallbacks accepted: HF_API_KEY, HUGGING_FACE_HUB_TOKEN.
# Create at https://huggingface.co/settings/tokens (read-only is enough).
HF_TOKEN=
# Optional tuning for the HF index 5-min windows (advanced):
# HF_INDEX_BACKLOG_BATCH_SIZE=500    # one-time newest->oldest catalog walk; token → 500, anon 250
# HF_INDEX_RECENT_BATCH_SIZE=50      # perpetual "what's new" top-up -- small, real upload volume/5min is tiny
# HF_INDEX_MAX_REPOS_PER_TICK=250    # staleness refresh cap
# HF_API_RATE_LIMIT=1000             # override learned API quota (rarely needed)
# HF_RESOLVERS_RATE_LIMIT=5000       # override learned resolvers quota
# HF_INDEX_TICK_INTERVAL_MS=300000   # 5 min default (matches HF's 5-min window)
